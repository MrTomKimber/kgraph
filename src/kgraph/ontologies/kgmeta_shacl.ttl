@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix kgmeta: <https://kgraph.foo/onto/kgmeta#> .


# Define expected property-shapes to be associated with any subject for which there is assigned a type
# This limits the scope of the validation to (typed) individuals - which *should* be a minimum requirement
# for any ingestion that includes naming (consider mappings though, which might arrive through a different
# channel )
kgmeta:NamedObjectShape a sh:NodeShape;
    sh:targetSubjectsOf rdf:type ;
    sh:nodeKind sh:IRI ;
    sh:property kgmeta:FullyQualifiedNamePropertyShape ;
    sh:property kgmeta:NamePropertyShape ;
    sh:property kgmeta:LabelPropertyShape ;
    sh:property kgmeta:DescriptionPropertyShape ;
    sh:property kgmeta:isScopedWithinPropertyShape ;
    sh:property kgmeta:isIntegralPartOfPropertyShape .
    
# The FullyQualifiedName property can and must only appear once, and when it does, it has a 
# prescriptive pattern to which it must conform
kgmeta:FullyQualifiedNamePropertyShape a sh:PropertyShape ;
    sh:path kgmeta:FullyQualifiedName ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "(((^|[A-Za-z0-9_()↔\\s\\-&]+[.])([A-Za-z0-9_()↔\\s\\-&]+))+)$" .

kgmeta:NamePropertyShape a sh:PropertyShape ;
    sh:path kgmeta:Name ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:pattern "(((^|[A-Za-z0-9_()↔\\s\\-&]+[.])([A-Za-z0-9_()↔\\s\\-&]+))+)$" .

kgmeta:LabelPropertyShape a sh:PropertyShape ;
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype xsd:string .

kgmeta:DescriptionPropertyShape a sh:PropertyShape ;
    sh:path kgmeta:Description ;
    sh:maxCount 1 ;
    sh:datatype xsd:string .

# IsScopedWithin should appear at most once, and the target of any scoping object should itself have a FullyQualifiedName
kgmeta:isScopedWithinPropertyShape a sh:PropertyShape ;
    sh:path kgmeta:isScopedWithin ;
    sh:maxCount 1 ;
    sh:class kgmeta:NamedObjectShape .

# isIntegralPartOf should appear at most once, and the target of any scoping object should itself have a FullyQualifiedName
kgmeta:isIntegralPartOfPropertyShape a sh:PropertyShape ;
    sh:path kgmeta:isIntegralPartOf ;
    sh:maxCount 1 ;
    sh:class kgmeta:NamedObjectShape .




