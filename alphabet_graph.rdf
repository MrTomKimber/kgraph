<rdf:RDF
   xmlns:ns1="https://kgraph.foo/onto/kgmeta#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#edf42252047f488aa6ec6c3882bc7878">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Monarch</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Monarch</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Monarch</skos:prefLabel>
    <rdfs:label>Monarch</rdfs:label>
    <skos:definition>A leadership role assigned to a person who rules over a kingdom or realm.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Monarch</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#9ec9fcf33704416fb1c27333c83dff88">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Xylophone</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Xylophone</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#c511b06bd632468199de936840fc4425"/>
    <skos:prefLabel>Xylophone</skos:prefLabel>
    <rdfs:label>Xylophone</rdfs:label>
    <skos:definition>A xylophone is a musical instrument consisting of wooden bars which when struck by mallets emit sounds tuned to different pitches. The word comes from ancient Greek xulon (meaning wood) and phone (sound or voice).</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Xylophone</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#628a78d0804e44eb90748fbafc247fa3">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Train</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Train</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#c511b06bd632468199de936840fc4425"/>
    <skos:prefLabel>Train</skos:prefLabel>
    <rdfs:label>Train</rdfs:label>
    <skos:definition>A train typically describes a series of connected vehicles that run along a railway track. They can be used to transport people or freight. A train is typically pulled by a locomotive (engine) though some trains might have their propulsion distributed acrooss carriages and powered by an external power-source. </skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Train</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#5071cb3cbfa84aa594f43b1a94e1bd6a">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Umbrella</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Umbrella</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#c511b06bd632468199de936840fc4425"/>
    <skos:prefLabel>Umbrella</skos:prefLabel>
    <rdfs:label>Umbrella</rdfs:label>
    <skos:definition>An umbrella is a folding ribbed canopy supported by an often hand-held central pole designed to protect a person from the effects of the sun (in the case of a parasol) or rain.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Umbrella</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#9f2b31ac40664578bb049bedf93ccb58">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Apple</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Apple</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#fc302436544244e7a4ec3d98e84bf0af"/>
    <skos:prefLabel>Apple</skos:prefLabel>
    <rdfs:label>Apple</rdfs:label>
    <skos:definition>An apple is a round, edible fruit borne by deciduous trees of the genus Malus.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Apple</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#582a6030e2d44992b1e0c29010ec186c">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Elephant</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Elephant</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Elephant</skos:prefLabel>
    <rdfs:label>Elephant</rdfs:label>
    <skos:definition>An elephant is a large land animal of the family Loxodonta that features a distinctive proboscis called a trunk, large ears and often tusks. Elephants tend to live in the wild, but can be domesticated in some cultures.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Elephant</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#115092c1bdd64d93b2b1a7d799f2e44a">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>House</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.House</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#3f623ddb97014a908bbdb9d9d3ab2e79"/>
    <skos:prefLabel>House</skos:prefLabel>
    <rdfs:label>House</rdfs:label>
    <skos:definition>A house is a residential building typically split into different functional rooms. Houses can be built from a variety of materials and traditional houses will often reflect materials that are available locally.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/House</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#e5f7871743b14984b6e86fc983c94fcd">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Rain</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Rain</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Rain</skos:prefLabel>
    <rdfs:label>Rain</rdfs:label>
    <skos:definition>Rain is the falling from the sky of water droplets that have condensed from atmospheric water vapour. Rain is a major component of the water cycle and is responsible for depositing most of the fresh-water on earth.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Rain</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#54175a4172c940a7868b9c8945e569a2">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Queen</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Queen</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#edf42252047f488aa6ec6c3882bc7878"/>
    <skos:related rdf:resource="https://kgraph.foo/skos/kgdmcar#168544f87ede4a61a5d58b74a4a906f7"/>
    <skos:prefLabel>Queen</skos:prefLabel>
    <rdfs:label>Queen</rdfs:label>
    <skos:definition>A queen is a female monarch, equivalent in rank, title and position to a King. She will reign over a realm known as a kingdom.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Queen_regnant</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#c511b06bd632468199de936840fc4425">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Artifact</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Artifact</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Artifact</skos:prefLabel>
    <rdfs:label>Artifact</rdfs:label>
    <skos:definition>An object or thing created as the result of human craftmanship.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#3b64e98e81104e76b55abf28018bad10">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Yak</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Yak</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Yak</skos:prefLabel>
    <rdfs:label>Yak</rdfs:label>
    <skos:definition>A yak is a bulky framed, long-haired animal belonging to the genus Bos and are found throughout north Asia. They are commonly kept as cattle but can also be found in the wild.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Yak</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#e2a22dcdbb954a5bac1f0ee7e92c8f5c">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Goat</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Goat</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Goat</skos:prefLabel>
    <rdfs:label>Goat</rdfs:label>
    <skos:definition>A goat is a medium-sized mammal of the family Bovidae. They are ruminants and are often kept as livestock but can also be found in the wild.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Goat</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#3ee3d26852de4f69b6fab9c315a4764e">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Dog</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Dog</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Dog</skos:prefLabel>
    <rdfs:label>Dog</rdfs:label>
    <skos:definition>A dog is a domesticated animal of the family Canis. Dogs are valued for their companionship, but are often employed in specialised roles to assist humans in multiple tasks.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Dog</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#a4470468392c4f638db1704fd94c474d">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Jungle</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Jungle</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Jungle</skos:prefLabel>
    <rdfs:label>Jungle</rdfs:label>
    <skos:definition>A jungle is a biome consisting of dense forest and tangled vegetation found in tropical climates that feature warm and humid conditions.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Jungle</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#f3cc527a613a4c6092b1886bb9ea64e0">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Cat</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Cat</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Cat</skos:prefLabel>
    <rdfs:label>Cat</rdfs:label>
    <skos:definition>A cat is a small domesticated species of the family Felidae. Cats are kept as pets and are valued for their companionship and ability to catch vermin.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Cat</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#feae434ad95048388225eb8866dbb587">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Parrot</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Parrot</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Parrot</skos:prefLabel>
    <rdfs:label>Parrot</rdfs:label>
    <skos:definition>A parrot is a bird with a strong curved beak, upright stance and clawed feet. They are broadly classified into four familes and are found in the wild, and sometimes as pets. They are among the most intelligent of birds and typically eat seeds, nuts or fruit.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Parrot</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Animal</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Animal</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Animal</skos:prefLabel>
    <rdfs:label>Animal</rdfs:label>
    <skos:definition>A multicellular, eukaryotic organism. Animals are different from other living things in that they cannot produce their own food, and tend to have to ingest organic material to survive.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Animal</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#3f623ddb97014a908bbdb9d9d3ab2e79">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Structure</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Structure</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Structure</skos:prefLabel>
    <rdfs:label>Structure</rdfs:label>
    <skos:definition>A physical arrangement of components that conforms to a template or pattern. Can be the result of natural or artificial processes.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Structure</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#9443764d34654274a499aa8d72b9087c">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Wheel</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Wheel</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#c511b06bd632468199de936840fc4425"/>
    <skos:prefLabel>Wheel</skos:prefLabel>
    <rdfs:label>Wheel</rdfs:label>
    <skos:definition>A wheel is a rotating circular component intended to turn around an axle. Wheels are typically found in transportation as a means to smoothly allow the application of a force to translate into linear motion. </skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Wheel</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#e8ea041581834a4794fe5ee04ec2adea">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Sun</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Sun</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Sun</skos:prefLabel>
    <rdfs:label>Sun</rdfs:label>
    <skos:definition>The Sun is the star at the centre of the Solar System that is the main source of light and energy for all life on Planet Earth. As the Earth spins, the sun can be seen to rise over the horizon, traverse across the sky in the day-time before setting at the end of the day below the horizon line. </skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Sun</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#fc302436544244e7a4ec3d98e84bf0af">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Fruit</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Fruit</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Fruit</skos:prefLabel>
    <rdfs:label>Fruit</rdfs:label>
    <skos:definition>An often edible component of a plant or vegetable that hosts seeds.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Fruit</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#960f0e95d4b04c3093cf1559191b9b04">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Imagination</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Imagination</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Imagination</skos:prefLabel>
    <rdfs:label>Imagination</rdfs:label>
    <skos:definition>Imagination is a creative cognitive process in which theories and ideas can be generated, simulated and mentally experienced.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Imagination</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#7724ece1b3864825b295e7703b3b1958">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Octopus</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Octopus</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Octopus</skos:prefLabel>
    <rdfs:label>Octopus</rdfs:label>
    <skos:definition>An octopus is a soft-bodied, eight-limbed mollusc of the class Cephalopod. They live in the ocean and are known for their intelligence, and in some species have the ability to camoflage and expell ink when threatened.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Octopus</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#168544f87ede4a61a5d58b74a4a906f7">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>King</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.King</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#edf42252047f488aa6ec6c3882bc7878"/>
    <skos:related rdf:resource="https://kgraph.foo/skos/kgdmcar#54175a4172c940a7868b9c8945e569a2"/>
    <skos:prefLabel>King</skos:prefLabel>
    <rdfs:label>King</rdfs:label>
    <skos:definition>A King is a royal title given to a male monarch who rules over a nation. A realm or nation over which a monarch reigns is called a Kingdom.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/King</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#11c440914671453a8f0e9d774ee4dae1">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Nest</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Nest</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#3f623ddb97014a908bbdb9d9d3ab2e79"/>
    <skos:prefLabel>Nest</skos:prefLabel>
    <rdfs:label>Nest</rdfs:label>
    <skos:definition>A nest is a structure constructed by an animal to hold its eggs or young. Nests are typically attributed to birds, but members of all classes of vertebrates and some invertebrates construct nests.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Nest</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#f5c9c572ad9a497db1393a44f5692404">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Fox</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Fox</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Fox</skos:prefLabel>
    <rdfs:label>Fox</rdfs:label>
    <skos:definition>A fox is a small-to-medium-sized omnivorous mammal belonging to the genus Vulpes. They are known for their cunning and adaptability and can be found in both rural and urban environments. </skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Fox</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#df1e4629c930423894b3fbb7d4262a5d">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Mouse</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Mouse</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Mouse</skos:prefLabel>
    <rdfs:label>Mouse</rdfs:label>
    <skos:definition>A mouse is a small rodent of the genus Mus. Mice typically have pointed snouts, small rounded ears and a long scaly tail. They can be found in multiple environments across the world, including urban environments where they can be considered vermin.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Mouse</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#bf9bd1560ea949d7b806c489a00a5e85">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Banana</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Banana</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#fc302436544244e7a4ec3d98e84bf0af"/>
    <skos:prefLabel>Banana</skos:prefLabel>
    <rdfs:label>Banana</rdfs:label>
    <skos:definition>A banana is an elongated, edible fruit (botalically a berry) of herbaceous plants of the genus Musa.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Banana</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <ns1:Name>TestAlphabetVocab</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab</ns1:FullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#3ac04da3335642c3806fc0ccdc1d7f80">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Zebra</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Zebra</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#117a7bb2466e46d29e46e902e672327a"/>
    <skos:prefLabel>Zebra</skos:prefLabel>
    <rdfs:label>Zebra</rdfs:label>
    <skos:definition>A zebra is a distinctlvely black-and-white striped animal found in the wild across eastern and southern regions of Africa and belong to the genus Equus. Unlike other animals of this genus, they have never been successfully domesticated.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Zebra</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#8233b1d980aa497c8ccd9842583baf8c">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Village</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Village</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:prefLabel>Village</skos:prefLabel>
    <rdfs:label>Village</rdfs:label>
    <skos:definition>A village is a human residential settlement typically consisting of a number of dwellings situated relatively close to one another to form a community.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Village</rdf:seeAlso>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/namespace#ae407747ae76485f802d424e6421abaa">
    <rdf:type rdf:resource="https://kgraph.foo/onto/kgmeta#Namespace"/>
    <ns1:Name>Vocabularies</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies</ns1:FullyQualifiedName>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/skos/kgdmcar#f0e082d3d23b48809b01ccc0eb1ca901">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <ns1:Name>Lemon</ns1:Name>
    <ns1:FullyQualifiedName>Vocabularies.TestAlphabetVocab.Lemon</ns1:FullyQualifiedName>
    <skos:inScheme rdf:resource="https://kgraph.foo/skos/kgdmcar#cbc9f867234c4d4a9c59f3c1fbb0e68d"/>
    <skos:narrower rdf:resource="https://kgraph.foo/skos/kgdmcar#fc302436544244e7a4ec3d98e84bf0af"/>
    <skos:prefLabel>Lemon</skos:prefLabel>
    <rdfs:label>Lemon</rdfs:label>
    <skos:definition>A lemon is the pointed oval yellow fruit of small evergreen trees of the genus Citrus.</skos:definition>
    <rdf:seeAlso>https://en.wikipedia.org/wiki/Lemon</rdf:seeAlso>
  </rdf:Description>
</rdf:RDF>
