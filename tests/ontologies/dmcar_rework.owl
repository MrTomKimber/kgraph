<?xml version="1.0"?>
<rdf:RDF xmlns="https://kgraph.foo/onto/datamodelling#"
     xml:base="https://kgraph.foo/onto/datamodelling"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:kgmod="https://kgraph.foo/onto/datamodelling#">
    <owl:Ontology rdf:about="https://kgraph.foo/onto/datamodelling">
        <owl:versionIRI rdf:resource="https://kgraph.foo/onto/datamodelling/v1.0.0"/>
        <rdfs:comment>A data-modelling metamodel describing entity composition and relationships as well as inter and cross-model mappings.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://kgraph.foo/onto/datamodelling#hasComponent -->

    <owl:ObjectProperty rdf:about="https://kgraph.foo/onto/datamodelling#hasComponent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
    </owl:ObjectProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#isAssociatedWith -->

    <owl:ObjectProperty rdf:about="https://kgraph.foo/onto/datamodelling#isAssociatedWith">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#isKnownBy -->

    <owl:ObjectProperty rdf:about="https://kgraph.foo/onto/datamodelling#isKnownBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment>Connects a Definition entity to a Vocabulary term by which the entity is known and understood within the context of the vocabulary.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:ObjectProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#isMemberOf -->

    <owl:ObjectProperty rdf:about="https://kgraph.foo/onto/datamodelling#isMemberOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>A membership relation from the member entity to another entity that acts as collection or group. Membership of a group is non-exclusive. 
Contrast with isPartOf which defines dependent, compositional relationships that are exclusively defined. i.e. functional</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:ObjectProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#isPartOf -->

    <owl:ObjectProperty rdf:about="https://kgraph.foo/onto/datamodelling#isPartOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment>Describes a compositional relationship between two entities. If an entity isPartOf another, this relationship is exclusive. An entity cannot be part of multiple parent entities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:ObjectProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#isSubclassOf -->

    <owl:ObjectProperty rdf:about="https://kgraph.foo/onto/datamodelling#isSubclassOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>A subsumptive relation from a a hyponym (a more specific type) to a hypernym (more general type).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:ObjectProperty>
    


    <!-- https://kgraph.foo/onto/kgnam#isScopedWithin -->

    <owl:ObjectProperty rdf:about="https://kgraph.foo/onto/kgnam#isScopedWithin"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://kgraph.foo/onto/datamodelling#Description -->

    <owl:DatatypeProperty rdf:about="https://kgraph.foo/onto/datamodelling#Description">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#RoleCardinality -->

    <owl:DatatypeProperty rdf:about="https://kgraph.foo/onto/datamodelling#RoleCardinality">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#RoleOptionality -->

    <owl:DatatypeProperty rdf:about="https://kgraph.foo/onto/datamodelling#RoleOptionality">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#RoleVerb -->

    <owl:DatatypeProperty rdf:about="https://kgraph.foo/onto/datamodelling#RoleVerb">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://kgraph.foo/onto/datamodelling#Role"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">A Verb that describes the role that an entity plays in its participation via an associated relationship.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://kgraph.foo/onto/kgnam#FullyQualifiedName -->

    <owl:DatatypeProperty rdf:about="https://kgraph.foo/onto/kgnam#FullyQualifiedName">
        <rdfs:domain rdf:resource="https://kgraph.foo/onto/kgnam#NamedObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://kgraph.foo/onto/kgnam#Name -->

    <owl:DatatypeProperty rdf:about="https://kgraph.foo/onto/kgnam#Name">
        <rdfs:domain rdf:resource="https://kgraph.foo/onto/kgnam#NamedObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#List -->

    <owl:Class rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- https://kgraph.foo/onto/datamodelling#Association -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Association">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Attribute -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Attribute">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Element"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#EntityType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An attribute is a property or feature that can be ascribed to an EntityType</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#AttributeMapping -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#AttributeMapping">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Mapping"/>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Binding -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Binding">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Association"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isAssociatedWith"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Element"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Mapping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A binding describes the specific application of a function&apos;s parameter to a defined Element (an attribute or parameter).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#DataStructure -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#DataStructure">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#EntityType"/>
        <rdfs:comment>A DataStructure acts as a blueprint and describes the structured collection of attributes used to define an object. In physical contexts, might be used to describe denormalised views containing information source from multiple entities, e.g. in the case of a file format, message or api response definition.</rdfs:comment>
        <rdfs:comment>A datastructure is separate from EntityType as it carries no implication of being a normalised object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Definition -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Definition">
        <rdfs:comment>In the realm of modelling, a definition is the core unit. Every definition should be named, described and reference other definitions through a constrained set of interactions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Domain -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Domain">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:comment>A Domain is a controlled expression of the domain of values that an attribute or parameter is expected to conform to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Element -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Element">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isMemberOf"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Domain"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#EntityMapping -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#EntityMapping">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Mapping"/>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#EntityType -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#EntityType">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:comment>An EntityType describes a concept, class, or table. Entities of the same EntityType are defined with common characteristics for which the EntityType acts as a container.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#ForeignKey -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#ForeignKey">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Key"/>
        <owl:disjointWith rdf:resource="https://kgraph.foo/onto/datamodelling#PrimaryKey"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Function -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Function">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:comment>A function defines the rules and logic required to map from a collection of zero or more input parameters to a collection of zero or more output parameter(s). It is a behavioral definition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#InputParameter -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#InputParameter">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Parameter"/>
        <owl:disjointWith rdf:resource="https://kgraph.foo/onto/datamodelling#OutputParameter"/>
        <rdfs:comment>An InputParameter is a function-scoped name to which values can be bound at execution-time for input into a function.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Key -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Key">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#EntityType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A Key is a formal way of referencing instances of an entity.</rdfs:comment>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Mapping -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Mapping">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Association"/>
        <rdfs:comment>A mapping is a directed link between entities across differenct models or taxonomies. Its meaning is dependent on the Mapping&apos;s type. For more physical mappings, a mapping may apply a transformation through the application of a bound FunctionDefninition&apos;s parameters.</rdfs:comment>
        <rdfs:comment>Mappings might be used to link between definitions at different levels (e.g. Logical to Physical for example) or across models at the same level (e.g. when identifying isomorphisms across models)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Model -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Model">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:comment>A model describes a collection of classes and their interacting relationships, along with any annotative information that further describes their context.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Namespace -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Namespace">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:comment>A namespace is a named set of names that are guaranteed to each be unambiguously assigned to an individual object. i.e. Each name defined in a namespace has a singular, definitive meaning or mapping to an object.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#OutputParameter -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#OutputParameter">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Parameter"/>
        <rdfs:comment>An OutputParemeter is a function-scoped name to which an output can be assigned as the result of performing a function.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Parameter -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Parameter">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Element"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A parameter is a function-scoped variable that can be bound with data from outside of the function. Parameters are defined as being input or output parameters to define flow.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#PrimaryKey -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#PrimaryKey">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Key"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Relationship -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Relationship">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Association"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#hasComponent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#sourceRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#hasComponent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#targetRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#hasComponent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A relationship describes a relation between two classes. A relationship will be directed from the source (or child) referencing entity to a target (or parent) referenced entity via their respective keys. These keys are used to establish how that relationship can be encoded in practice, or for relationships with less defined specificity, they will exist as nominal placeholders.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#Role -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#Role">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Relationship"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isAssociatedWith"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Key"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A Role is the abstract representation of how an Entity participates in a Relationship. Each relationship definition should be associated with a SourceRole and a TargetRole.
The relationship&apos;s multiplicity (cardinality + optionality) properties are recorded against the role, as are any key-definitions used to implement the role.</rdfs:comment>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#SubType -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#SubType">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Association"/>
        <rdfs:comment>An association between two classes that are taxonomically related. The child class being a more specific subset of the more generalised parent.</rdfs:comment>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#SubjectArea -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#SubjectArea">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:comment>A SubjectArea describes a thematic category or topic of area of interest. Individual Classes might be tagged with one or more SubjectAreas depending on their association to different contexts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#sourceRole -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#sourceRole">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Role"/>
        <owl:disjointWith rdf:resource="https://kgraph.foo/onto/datamodelling#targetRole"/>
        <rdfs:comment>The sourceRole is the role a participant plays at the source of a relationship.</rdfs:comment>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/datamodelling#targetRole -->

    <owl:Class rdf:about="https://kgraph.foo/onto/datamodelling#targetRole">
        <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Role"/>
        <rdfs:comment>The targetRole is the role a participant plays at the target end of a relationship.</rdfs:comment>
    </owl:Class>
    


    <!-- https://kgraph.foo/onto/kgnam#NamedObject -->

    <owl:Class rdf:about="https://kgraph.foo/onto/kgnam#NamedObject"/>
    


    <!-- https://kgraph.foo/onto/kgnam#Namespace -->

    <owl:Class rdf:about="https://kgraph.foo/onto/kgnam#Namespace">
        <owl:equivalentClass>
            <owl:Class>
