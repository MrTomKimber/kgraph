    <!-- https://kgraph.foo/onto/datamodelling#FullyQualifiedName -->

    <owl:DatatypeProperty rdf:about="https://kgraph.foo/onto/datamodelling#FullyQualifiedName">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
        <rdfs:comment>A string constructed by appending local names and traversing the root-to-leaf-path defined by the isEnclosedBy object property hierarchy. If each Enclosing node guarantees the distinctness of the names defined within it, then each FullyQualifiedName should perform as unique identifiers. 

By convention, the joins are delimited by dots to return the final FullyQualifiedName, and this has an impact on the legal characters available to construct each local name.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
    </owl:DatatypeProperty>
    


    <!-- https://kgraph.foo/onto/datamodelling#RoleVerb -->

