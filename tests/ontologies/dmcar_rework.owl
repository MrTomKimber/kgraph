<!-- http://kgraph.foo/onto/modelling#IsEnclosedBy -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling#IsEnclosedBy">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:comment>Describes the relationship between entities where the first entity's name is defined locally (and guaranteed uniqueness) within the scope of  some other entity that acts as a namespace.</rdfs:comment>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling#appliesFunction -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling#appliesFunction">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:domain rdf:resource="http://kgraph.foo/onto/modelling#Mapping"/>
	<rdfs:range rdf:resource="http://kgraph.foo/onto/modelling#Function"/>
	<rdfs:comment>A relationship from a mapping to the function definition used to template the application of that mapping.</rdfs:comment>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling#hasBinding -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling#hasBinding">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:domain rdf:resource="http://kgraph.foo/onto/modelling#Parameter"/>
	<rdfs:range rdf:resource="http://kgraph.foo/onto/modelling#Element"/>
	<rdfs:comment>A relationship between a mapping unit and any of the bindings that are used to specify its application against a schema.</rdfs:comment>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling#hasParameter -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling#hasParameter">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:domain rdf:resource="http://kgraph.foo/onto/modelling#Function"/>
	<rdfs:range rdf:resource="http://kgraph.foo/onto/modelling#Parameter"/>
	<rdfs:comment>A relation from a function definition to one of the parameters that function exposes for binding.</rdfs:comment>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling#hasSource -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling#hasSource">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:domain rdf:resource="http://kgraph.foo/onto/modelling#Association"/>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling#hasTarget -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling#hasTarget">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:domain rdf:resource="http://kgraph.foo/onto/modelling#Association"/>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling#isKnownBy -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling#isKnownBy">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:domain rdf:resource="http://kgraph.foo/onto/modelling#Definition"/>
	<rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:comment>Connects a Definition entity to a Vocabulary term by which the entity is known and understood within the context of the vocabulary.</rdfs:comment>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling#isSubclassOf -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling#isSubclassOf">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:comment>A subsumptive relation from a a hyponym (a more specific type) to a hypernym (more general type).</rdfs:comment>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling##isMemberOf -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling##isMemberOf">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:comment>A membership relation from the member entity to another entity that acts as collection or group.</rdfs:comment>
</rdf:Description>
<!--  -->
<!-- http://kgraph.foo/onto/modelling##isPartOf -->

<rdf:Description rdf:about="http://kgraph.foo/onto/modelling##isPartOf">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
	<rdfs:comment>Describes a compositional relationship between two entities</rdfs:comment>
</rdf:Description>
