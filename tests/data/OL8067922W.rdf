    <frbr:Work rdf:about="http://openlibrary.org/works/OL8067922W">
            <dcterms:title>I Am a Strange Loop</dcterms:title>
    


      <dcterms:creator>
          <rdf:Description rdf:about="http://openlibrary.org/authors/OL57437A">
              <foaf:name>Douglas R. Hofstadter</foaf:name>
          </rdf:Description>
      </dcterms:creator>
      
          <dcterms:subject>Self (Philosophy)</dcterms:subject>
    <dcterms:subject>Intellect</dcterms:subject>
    <dcterms:subject>Consciousness</dcterms:subject>
    <dcterms:subject>Soul</dcterms:subject>
